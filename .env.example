# Copy with ./scripts/dev-env.sh. The placeholders below are not valid secrets.
# Never commit .env. Local Compose publishes only loopback ports.

# Shared browser access. One password opens the secure workspace sign-in page.
CODE_SERVER_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
CLOUDDEV_WORKSPACE_AUTH_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
CLOUDDEV_HTTP_PORT=8080
CLOUDDEV_CODE_SERVER_PORT=8081
CLOUDDEV_CLOUDCLI_PORT=3001
LAUNCHPAD_PORT=3002
LAUNCHPAD_BASE_PATH=/launchpad
CLOUDDEV_PROJECTS_DIR=/workspace/projects

# Public SSH access to the workspace uses a separate operator key. Paste one
# or more OpenSSH public keys here, one per line. Do not paste private keys.
SSH_AUTHORIZED_KEYS=
CLOUDDEV_SSH_PORT=2222
IDE_SSH_PROXY_HOST=localhost
IDE_SSH_PROXY_PORT=2222

# Private service addresses for local Compose.
CLOUDDEV_OMNIROUTE_HOST=clouddev-router
CLOUDDEV_OMNIROUTE_PORT=20128
CLOUDDEV_OMNIROUTE_PROXY_PORT=20129
CLOUDDEV_OMNIROUTE_BASE_URL=http://127.0.0.1:20129
CLOUDDEV_FORGEJO_HOST=clouddev-git
CLOUDDEV_FORGEJO_PORT=3000
WORKSPACE_PUBLIC_URL=http://localhost:8080
GIT_PUBLIC_URL=http://localhost:3000
ROUTER_PUBLIC_URL=http://localhost:8080/omniroute
FORGEJO_ROOT_URL=http://localhost:3000/

# PostgreSQL. Forgejo gets a separate application role and database.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
FORGEJO_POSTGRES_ROLE=clouddev_forgejo
FORGEJO_POSTGRES_DATABASE=forgejo
FORGEJO_POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
FORGEJO_SSH_DOMAIN=localhost
FORGEJO_SSH_PORT=2223
FORGEJO_SSH_LISTEN_PORT=2222
GIT_SSH_PROXY_HOST=localhost
GIT_SSH_PROXY_PORT=2223

# First Forgejo administrator. Retrieve it locally from .env, then change it
# after first sign-in. No Forgejo admin token is created or given to the IDE.
FORGEJO_ADMIN_USERNAME=owner
FORGEJO_ADMIN_EMAIL=owner@localhost.invalid
FORGEJO_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# OmniRoute secrets. API_KEY_SECRET protects API keys; STORAGE_ENCRYPTION_KEY
# encrypts its SQLite database. Keep every value with the corresponding backup.
PORT=20128
INITIAL_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
API_KEY_SECRET=REPLACE_WITH_A_RANDOM_SECRET
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_SECRET
STORAGE_ENCRYPTION_KEY_VERSION=v1
MACHINE_ID_SALT=REPLACE_WITH_A_RANDOM_SECRET
OMNIROUTE_WS_BRIDGE_SECRET=REPLACE_WITH_A_RANDOM_SECRET
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=true
APP_LOG_LEVEL=warn
APP_LOG_TO_FILE=false
APP_LOG_RETENTION_DAYS=1
CALL_LOG_RETENTION_DAYS=1
ENABLE_REQUEST_LOGS=false
CALL_LOG_PIPELINE_CAPTURE_STREAM_CHUNKS=false
PROXY_LOG_INCLUDE_IPS=false
PROXY_LOG_FIRST_CHUNK_TIMING=false
ARENA_ELO_SYNC_ENABLED=false
MODELS_DEV_SYNC_ENABLED=false

# These are created by `ai-setup` after the operator adds a provider in the
# authenticated OmniRoute dashboard. Never put a provider master key here.
